[run]
source = terravault
# Branch coverage was off, so coverage.xml reported branch-rate 0.0 — an absence
# of measurement, not a result. The quality gate's coverage figure only covered
# lines until this was enabled.
branch = True
omit =
    */tests/*
    */test_*.py
    */__pycache__/*
    */venv/*
    */.venv/*
    */site-packages/*

[report]
# Set minimum coverage threshold
precision = 2
show_missing = True
skip_covered = False
skip_empty = True

# Exclude certain lines from coverage
exclude_lines =
    pragma: no cover
    def __repr__
    def __str__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    @abc.abstractmethod
    pass
    \.\.\.

[html]
directory = htmlcov
title = TerraVault Coverage Report

[xml]
output = coverage.xml
