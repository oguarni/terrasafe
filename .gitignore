# ===================================
# Git Backups (created during history cleanup)
# ===================================
.git.backup/
.git.bak/

# ===================================
# Database backups (runtime dumps)
# ===================================
# Local output dir for scripts/backup_db.sh on the deploy VM before the dump
# is shipped to GCS. Untracked runtime artifacts — keep the deploy working
# tree clean so scripts/deploy_vm.sh's dirty-tree guard does not abort.
backups/

# ===================================
# Evaluation harness — raw scanner cache (regenerable via `make evaluate`)
# ===================================
# Keep the corpus, code, report.md, metrics.json and tables tracked; the 66
# per-tool raw JSON dumps are a regenerable cache, not source.
evaluation/results/raw/
# Same rule for the third-party (KICS) run's competitor dumps.
evaluation/results/foreign/raw/

