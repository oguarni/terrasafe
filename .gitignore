.terraform.d/
.terragrunt-cache/
terraform.tfstate.d/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
!*.example.tfvars
!*.example.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

